2025-11-23 01:15:19.536 [http-nio-8080-exec-9] DEBUG c.e.r.mapper.RuleDefinitionMapper.updateById - ==> Parameters: test1(String), test1(String), test1(String), INFECTIOUS_DISEASE(String), 1(Long), CONDITION(String), 100(Integer), 1(Integer), package rules.infectious_disease;

import java.util.Map;
import java.util.List;
import java.util.Arrays;
import com.example.ruleengine.engine.RuleContext;
import com.example.ruleengine.engine.RuleResult;

global RuleResult ruleResult;

rule "test1"
    salience 100
when
    $context : RuleContext()
    $data : Map() from $context.inputData
    eval((($data.get("diagnosis_code") != null && $data.get("diagnosis_code").toString().equals("1")) && ($data.get("diagnosis_type") != null && $data.get("diagnosis_type").toString().equals("1"))) || (($data.get("diagnosis_code") != null && $data.get("diagnosis_code").toString().equals("2")) && ($data.get("diagnosis_type") != null && $data.get("diagnosis_type").toString().equals("2"))))
then
    ruleResult.addMatchedRuleCode("test1");
    ruleResult.setOutput("code", 200);
    
end

(String), {"ruleCode":"test1","ruleType":"CONDITION","ruleName":"test1","priority":100,"conditions":[{"fieldCode":"diagnosis_code","valueType":"STRING","groupId":2,"fieldValue":"1","operator":"EQ"},{"fieldCode":"diagnosis_type","valueType":"STRING","groupId":2,"fieldValue":"1","operator":"EQ"},{"fieldCode":"diagnosis_code","valueType":"STRING","groupId":3,"fieldValue":"2","operator":"EQ"},{"fieldCode":"diagnosis_type","valueType":"STRING","groupId":3,"fieldValue":"2","operator":"EQ"}],"actions":[{"actionType":"RETURN","actionParams":"{\"code\":200}","sortOrder":0}]}(String), 3(Integer), system(String), 2025-11-23T01:05:02(LocalDateTime), null, 2025-11-23T01:05:02(LocalDateTime), 8(Long)
