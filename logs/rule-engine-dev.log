import java.util.Map;
import java.util.List;
import java.util.Arrays;
import com.example.ruleengine.engine.RuleContext;
import com.example.ruleengine.engine.RuleResult;

global RuleResult ruleResult;

rule "test1"
    salience 100
when
    $context : RuleContext()
    $data : Map() from $context.inputData
    eval((($data.get("diagnosis_code") != null && $data.get("diagnosis_code").toString().equals("1")) && ($data.get("diagnosis_type") != null && $data.get("diagnosis_type").toString().equals("1"))) || (($data.get("diagnosis_code") != null && $data.get("diagnosis_code").toString().equals("2"))))
then
    ruleResult.addMatchedRuleCode("test1");
    ruleResult.setOutput("code", 200);
    
end

