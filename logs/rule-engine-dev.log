import java.util.Map;
import java.util.List;
import java.util.Arrays;
import com.example.ruleengine.engine.RuleContext;
import com.example.ruleengine.engine.RuleResult;

global RuleResult ruleResult;

rule "11113"
    salience 100
when
    $context : RuleContext()
    $data : Map() from $context.inputData
    eval((($data.get("diagnosis_code") != null && $data.get("diagnosis_code").toString().equals("222")) && ($data.get("diagnosis_type") != null && $data.get("diagnosis_type").toString().equals("221")) && ($data.get("lab_hiv_antibody") != null && $data.get("lab_hiv_antibody").toString().contains("1111"))))
then
    ruleResult.addMatchedRuleCode("11113");
    ruleResult.setOutput("code", 222);
    
end

